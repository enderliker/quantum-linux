#!/usr/bin/env bash
# Modo rendimiento de Quantum: repos optimizados de CachyOS + planificador para juegos.
# Uso (como root): performance status|enable|disable
# El Centro Quantum lo ejecuta en una terminal para que se vea el progreso y las
# preguntas de pacman.
set -euo pipefail

STATE=/var/lib/quantum/performance
CACHYOS_GPG_KEY=F3B607488BE357A5

cpu_level() {
    local out
    out=$(/lib/ld-linux-x86-64.so.2 --help 2>/dev/null || true)
    if grep -q "x86-64-v4 (supported" <<<"$out"; then echo v4
    elif grep -q "x86-64-v3 (supported" <<<"$out"; then echo v3
    else echo old; fi
}

status() {
    local repo=off sched=off
    [[ -f /etc/pacman.conf ]] && grep -q '^\[cachyos' /etc/pacman.conf && repo=on
    systemctl is-enabled -q scx_loader.service 2>/dev/null && sched=on
    echo "cpu=$(cpu_level) repo=$repo sched=$sched"
}

setup_cachyos_repos() {
    local level="$1"
    echo "==> Configurando clave GPG oficial de CachyOS en pacman-key…"
    pacman-key --recv-keys "$CACHYOS_GPG_KEY" >/dev/null 2>&1 || \
        pacman-key --recv-keys "$CACHYOS_GPG_KEY" --keyserver keyserver.ubuntu.com >/dev/null 2>&1 || \
        pacman-key --recv-keys "$CACHYOS_GPG_KEY" --keyserver hkps://keys.openpgp.org >/dev/null 2>&1
    pacman-key --lsign-key "$CACHYOS_GPG_KEY" >/dev/null 2>&1

    echo "==> Configurando listas de servidores de CachyOS…"
    mkdir -p /etc/pacman.d
    cat > /etc/pacman.d/cachyos-mirrorlist <<'EOF'
Server = https://mirror.cachyos.org/repo/$arch/$repo
EOF
    cat > /etc/pacman.d/cachyos-v3-mirrorlist <<'EOF'
Server = https://mirror.cachyos.org/repo/$arch_v3/$repo
EOF
    cat > /etc/pacman.d/cachyos-v4-mirrorlist <<'EOF'
Server = https://mirror.cachyos.org/repo/$arch_v4/$repo
EOF

    local block_file
    block_file=$(mktemp)
    if [[ "$level" == "v4" ]]; then
        cat > "$block_file" <<'EOF'
# BEGIN CACHYOS
[cachyos-v4]
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos-core-v4]
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos-extra-v4]
Include = /etc/pacman.d/cachyos-v4-mirrorlist

[cachyos]
Include = /etc/pacman.d/cachyos-mirrorlist
# END CACHYOS
EOF
    else
        cat > "$block_file" <<'EOF'
# BEGIN CACHYOS
[cachyos-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-core-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos-extra-v3]
Include = /etc/pacman.d/cachyos-v3-mirrorlist

[cachyos]
Include = /etc/pacman.d/cachyos-mirrorlist
# END CACHYOS
EOF
    fi

    echo "==> Integrando repositorios de CachyOS en /etc/pacman.conf…"
    python3 -c "
with open('/etc/pacman.conf', 'r') as f:
    content = f.read()
if '[cachyos' not in content:
    with open('$block_file', 'r') as bf:
        block = bf.read()
    if '[core]' in content:
        content = content.replace('[core]', block + '\n[core]')
    else:
        content += '\n' + block
    with open('/etc/pacman.conf', 'w') as f:
        f.write(content)
"
    rm -f "$block_file"
    echo "==> Actualizando base de datos de paquetes con CachyOS…"
    pacman -Sy --needed --noconfirm cachyos-keyring cachyos-mirrorlist cachyos-v3-mirrorlist 2>/dev/null || pacman -Sy
}

remove_cachyos_repos() {
    echo "==> Removiendo repositorios de CachyOS de /etc/pacman.conf…"
    sed -i '/# BEGIN CACHYOS/,/# END CACHYOS/d' /etc/pacman.conf
    # Limpieza por si quedaron entradas sueltas previas
    sed -i '/^\[cachyos/d; /Include = \/etc\/pacman\.d\/cachyos/d' /etc/pacman.conf
    rm -f /etc/pacman.d/cachyos*mirrorlist
    echo "==> Actualizando base de datos de paquetes estándar…"
    pacman -Sy
}

enable() {
    local level
    level=$(cpu_level)
    if [[ "$level" == old ]]; then
        echo "Tu procesador no es compatible con los paquetes optimizados (necesita x86-64-v3)."
        echo "Solo se activará el planificador para juegos."
    else
        setup_cachyos_repos "$level"
    fi
    echo "==> Activando el planificador para juegos (scx_lavd)…"
    pacman -S --needed --noconfirm scx-scheds scx-tools
    cat > /etc/scx_loader.toml <<'EOF'
# Quantum Linux: planificador para juegos (modo rendimiento)
default_sched = "scx_lavd"
default_mode = "Gaming"
EOF
    systemctl enable --now scx_loader.service
    mkdir -p "$(dirname "$STATE")" && touch "$STATE"
    echo
    echo "Listo. Reinicia el equipo para usar todos los paquetes optimizados."
}

disable() {
    systemctl disable --now scx_loader.service 2>/dev/null || true
    rm -f /etc/scx_loader.toml
    if grep -q '^\[cachyos' /etc/pacman.conf; then
        remove_cachyos_repos
    fi
    rm -f "$STATE"
    echo
    echo "Listo. Quantum volvió a los paquetes normales de Arch."
}

case "${1:-status}" in
    status) status ;;
    enable) enable ;;
    disable) disable ;;
    *) echo "Uso: $0 status|enable|disable" >&2; exit 2 ;;
esac
